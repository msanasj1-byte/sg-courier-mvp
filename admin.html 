<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SG Courier Admin</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f8;
      color: #1f2937;
    }

    header {
      background: #111827;
      color: white;
      padding: 22px 18px;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .brand h1 {
      font-size: 25px;
      margin-bottom: 4px;
    }

    .brand p {
      color: #d1d5db;
      font-size: 14px;
    }

    .status {
      background: #065f46;
      color: white;
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 25px 16px 50px;
    }

    .welcome {
      background: white;
      padding: 22px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .welcome h2 {
      margin-bottom: 8px;
    }

    .welcome p {
      color: #6b7280;
      line-height: 1.5;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .card h3 {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 10px;
    }

    .card .number {
      font-size: 30px;
      font-weight: bold;
      color: #111827;
    }

    .controls {
      background: white;
      padding: 18px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    input,
    select {
      padding: 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 15px;
      flex: 1;
      min-width: 180px;
    }

    button {
      border: none;
      padding: 12px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
    }

    .refresh-btn {
      background: #111827;
      color: white;
    }

    .requests {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .requests-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .requests-header h2 {
      font-size: 20px;
    }

    .firebase-status {
      font-size: 13px;
      background: #fef3c7;
      color: #92400e;
      padding: 7px 11px;
      border-radius: 20px;
      font-weight: bold;
    }

    .firebase-connected {
      background: #d1fae5;
      color: #065f46;
    }

    .firebase-error {
      background: #fee2e2;
      color: #991b1b;
    }

    .empty-state {
      text-align: center;
      padding: 45px 15px;
      color: #6b7280;
    }

    .empty-icon {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .empty-state h3 {
      color: #374151;
      margin-bottom: 8px;
    }

    .empty-state p {
      line-height: 1.5;
      max-width: 520px;
      margin: auto;
    }

    footer {
      text-align: center;
      color: #6b7280;
      padding: 20px;
      font-size: 13px;
    }

    @media (max-width: 800px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 500px) {
      .stats {
        grid-template-columns: 1fr;
      }

      .brand h1 {
        font-size: 21px;
      }

      main {
        padding: 16px 12px 40px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="header-inner">

      <div class="brand">
        <h1>SG Courier Admin</h1>
        <p>Delivery Management Control Centre</p>
      </div>

      <div class="status">
        Admin Page Online
      </div>

    </div>
  </header>

  <main>

    <section class="welcome">
      <h2>Welcome to SG Courier Admin</h2>

      <p>
        Receive customer delivery requests, manage deliveries,
        assign verified drivers and monitor delivery status.
      </p>
    </section>

    <section class="stats">

      <div class="card">
        <h3>Total Requests</h3>
        <div class="number" id="totalCount">0</div>
      </div>

      <div class="card">
        <h3>Pending</h3>
        <div class="number" id="pendingCount">0</div>
      </div>

      <div class="card">
        <h3>Active Deliveries</h3>
        <div class="number" id="activeCount">0</div>
      </div>

      <div class="card">
        <h3>Delivered</h3>
        <div class="number" id="deliveredCount">0</div>
      </div>

    </section>

    <section class="controls">

      <input
        type="text"
        id="searchInput"
        placeholder="Search customer, address or request..."
      >

      <select id="statusFilter">
        <option value="all">All Statuses</option>
        <option value="pending">Pending</option>
        <option value="accepted">Accepted</option>
        <option value="collected">Collected</option>
        <option value="delivered">Delivered</option>
      </select>

      <button
        class="refresh-btn"
        id="refreshButton"
        type="button"
      >
        Refresh
      </button>

    </section>

    <section class="requests">

      <div class="requests-header">

        <h2>Customer Delivery Requests</h2>

        <span
          class="firebase-status"
          id="firebaseStatus"
        >
          Connecting to Firebase...
        </span>

      </div>

      <div id="requestList">

        <div class="empty-state">

          <div class="empty-icon">📦</div>

          <h3>Admin page is ready</h3>

          <p>
            Firebase is being connected. Customer delivery requests
            will appear here once the customer request page is linked
            to the database.
          </p>

        </div>

      </div>

    </section>

  </main>

  <footer>
    SG Courier &copy;
    <span id="year"></span>
    — Admin Control Centre
  </footer>


  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>


  <script>

    /* =========================================
       SG COURIER FIREBASE CONFIGURATION
       ========================================= */

    const firebaseConfig = {
      apiKey: "AIzaSyD6h1jN0RgXBbIqrjri9gSPUZbymFfPtLo",
      authDomain: "sg-courier.firebaseapp.com",
      projectId: "sg-courier",
      storageBucket: "sg-courier.firebasestorage.app",
      messagingSenderId: "718910401322",
      appId: "1:718910401322:web:6ff7a20babca071baa4c53",
      measurementId: "G-KXQGW871V3"
    };


    /* =========================================
       PAGE ELEMENTS
       ========================================= */

    const firebaseStatus =
      document.getElementById("firebaseStatus");

    const searchInput =
      document.getElementById("searchInput");

    const statusFilter =
      document.getElementById("statusFilter");

    const refreshButton =
      document.getElementById("refreshButton");


    /* =========================================
       CURRENT YEAR
       ========================================= */

    document.getElementById("year").textContent =
      new Date().getFullYear();


    /* =========================================
       FIREBASE INITIALIZATION
       ========================================= */
   let db;

try {

  firebase.initializeApp(firebaseConfig);

  db = firebase.firestore();

      firebaseStatus.textContent =
        "Firebase connected ✓";

      firebaseStatus.classList.add(
        "firebase-connected"
      );

      console.log(
        "SG Courier Firebase initialized successfully."
      );

    } catch (error) {

      firebaseStatus.textContent =
        "Firebase connection error";

      firebaseStatus.classList.add(
        "firebase-error"
      );

      console.error(
        "Firebase initialization error:",
        error
      );

    }


    /* =========================================
       REFRESH BUTTON
       ========================================= */

    refreshButton.addEventListener(
      "click",
      function () {

        refreshButton.textContent =
          "Ready ✓";

        setTimeout(function () {

          refreshButton.textContent =
            "Refresh";

        }, 1200);

      }
    );


    /* =========================================
       SEARCH
       ========================================= */

    searchInput.addEventListener(
      "input",
      function () {

        console.log(
          "Search:",
          searchInput.value
        );

      }
    );


    /* =========================================
       STATUS FILTER
       ========================================= */

    statusFilter.addEventListener(
      "change",
      function () {

        console.log(
          "Status:",
          statusFilter.value
        );

      }
    );


    console.log(
      "SG Courier Admin loaded successfully."
    );

  </script>

</body>
</html>